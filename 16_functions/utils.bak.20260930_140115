#!/usr/bin/env bash

mkcd() {
    mkdir -p "$1" && cd "$1"
}

file_exists() {
    # variables inside functions have global scope
   
    # makes variable local to this function
    local file="$1"


    # if [[ -f "$file" ]]; then
    # return 0
    # else
    # return 1
    # fi
    [[ -f "$file" ]] || return 1
    # It's the same code but written in a shorter way "if [[ ]] is not true then do what is after || "
}

bak() {
    local file="$1"
    file_exists "$file"

    local backup="$file.bak.$(date +%Y%m%d_%H%M%S)"
    cp "$file" "$backup"
}

