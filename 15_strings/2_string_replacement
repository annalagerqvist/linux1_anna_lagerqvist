#!/usr/bin/env bash

fruit='sweet mango mango'

# replace first mango with kiwi
echo "${fruit/mango/kiwi}"
# replaces all mango
echo "${fruit//mango/kiwi}"
# replace last mango with kiwi
echo "${fruit/%mango/kiwi}"

# replaces from the beginning
echo "${fruit/#mango/kiwi}"
echo "${fruit/#sweet/sour}"
